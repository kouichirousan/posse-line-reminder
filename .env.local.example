# このファイルをコピーして .env.local を作り、実際の値を入れる（.env.local はgit管理外）
# cp .env.local.example .env.local

# LINE Developers > Messaging API設定 から取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# リマインドを送信するLINEグループのID（テスト用グループでOK）
# botがどこかのグループでメッセージを受け取ると、Vercelのログに event.source.groupId が出るのでそこから取得する
LINE_TARGET_GROUP_ID=

# Googleサービスアカウント（JSON鍵ファイルの中身から転記）
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 秘密鍵は改行を \n に置き換えて1行で入れる
GOOGLE_PRIVATE_KEY=

# 対象のGoogleスプレッドシートのID（URLの /d/ と /edit の間の文字列）
GOOGLE_SHEET_ID=

# シート（タブ）名。空欄のままならコード側の初期値（lib/sheets.ts）が使われる。
# 100スピのタブ名は末尾に半角スペースが付いた "6期生＆7期生100スピ・birthdayローテ " が正式名称（2026-09-16確認）。
# ここに設定する場合は末尾スペースが消えないよう注意（コピペや保存時に切り詰められることがある）。
# 迷ったら空欄のままにして、コード側の初期値に任せるのが安全。
SHEET_NAME_100SPEECH=
SHEET_NAME_BIRTHDAY=

# 誕生日の何日前に早期リマインドを送るか
BIRTHDAY_ADVANCE_DAYS=7

# 1:1チャットでの設定変更を許可するLINEユーザーID（カンマ区切り、カルチャー局メンバー）
ALLOWED_LINE_USER_IDS=

# ANTHROPIC_API_KEYは2026-09-16に撤去済み（正規表現ベースの意図解釈＋編集距離ベースの
# 名前照合に置き換え、Anthropic APIへの依存を完全に無くした）。設定不要。

# GitHub Actionsからのリマインド送信リクエストを認証する共有シークレット（自分で適当な文字列を決める）
CRON_SECRET=
